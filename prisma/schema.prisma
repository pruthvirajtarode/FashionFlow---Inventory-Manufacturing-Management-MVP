// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// --------------------------------------------------
// USER & RBAC
// --------------------------------------------------
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  phone         String?
  password      String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userRoles     UserRole[]
  auditLogs     AuditLog[]
  transactions  FabricInventoryTransaction[]
  garmentTrans  GarmentInventoryTransaction[]
}

model Role {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String    @unique
  description   String?
  
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String    @unique
  description   String?
  
  rolePermissions RolePermission[]
}

model UserRole {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @db.ObjectId
  roleId  String @db.ObjectId
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
}

model RolePermission {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String @db.ObjectId
  permissionId String @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
}

// --------------------------------------------------
// MASTER DATA
// --------------------------------------------------
model Fabric {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  sku           String    @unique
  name          String
  type          String
  material      String
  color         String
  gsm           Float?
  width         Float?
  uom           String    @default("meters")
  avgCost       Float?
  supplier      String?
  minimumStock  Float     @default(0)
  targetDays    Int       @default(30)
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rolls         FabricRoll[]
  skus          SKU[]
}

model Product {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  style         String
  category      String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  skus          SKU[]
}

model SKU {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  sku                 String    @unique
  productId           String    @db.ObjectId
  size                String
  color               String
  variant             String?
  fabricId            String    @db.ObjectId
  avgFabricConsumption Float
  targetReadyStockDays Int      @default(15)
  active              Boolean   @default(true)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabric              Fabric    @relation(fields: [fabricId], references: [id], onDelete: Restrict)
  garments            Garment[]
  cuttingBatches      CuttingBatch[]
  transactions        GarmentInventoryTransaction[]
}

model Fabricator {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  contactPerson String?
  phone         String?
  address       String?
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  challans      Challan[]
}

// --------------------------------------------------
// FABRIC INVENTORY
// --------------------------------------------------
model FabricRoll {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  rollId          String    @unique 
  barcode         String    @unique
  fabricId        String    @db.ObjectId
  batchLot        String?
  supplier        String?
  originalQty     Float
  currentQty      Float
  status          String    @default("AVAILABLE") 
  location        String?
  cost            Float?
  notes           String?
  purchaseDate    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fabric          Fabric    @relation(fields: [fabricId], references: [id], onDelete: Restrict)
  transactions    FabricInventoryTransaction[]
  cuttingRolls    CuttingBatchRoll[]
}

model FabricInventoryTransaction {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  rollId        String    @db.ObjectId
  type          String    
  qtyChange     Float
  beforeQty     Float
  afterQty      Float
  referenceId   String?   
  userId        String?   @db.ObjectId
  notes         String?
  timestamp     DateTime  @default(now())

  roll          FabricRoll @relation(fields: [rollId], references: [id], onDelete: Restrict)
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// --------------------------------------------------
// PRODUCTION: CUTTING
// --------------------------------------------------
model CuttingBatch {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  batchId       String    @unique 
  skuId         String    @db.ObjectId
  expectedQty   Int
  actualQty     Int?
  cutter        String?
  cuttingMaster String?
  status        String    @default("PLANNED") 
  notes         String?
  date          DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sku           SKU       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  rolls         CuttingBatchRoll[]
  garments      Garment[]
  challans      Challan[]
}

model CuttingBatchRoll {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  cuttingBatchId  String    @db.ObjectId
  rollId          String    @db.ObjectId
  qtyIssued       Float

  cuttingBatch    CuttingBatch @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)
  roll            FabricRoll   @relation(fields: [rollId], references: [id], onDelete: Restrict)
}

// --------------------------------------------------
// GARMENT INVENTORY & TRACEABILITY
// --------------------------------------------------
model Garment {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  garmentId       String    @unique 
  barcode         String    @unique
  skuId           String    @db.ObjectId
  cuttingBatchId  String    @db.ObjectId
  status          String    @default("CUT") 
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sku             SKU       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  cuttingBatch    CuttingBatch @relation(fields: [cuttingBatchId], references: [id], onDelete: Restrict)
  challanItems    ChallanItem[]
  statusHistory   GarmentStatusHistory[]
}

model GarmentStatusHistory {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  garmentId     String    @db.ObjectId
  status        String
  userId        String?   @db.ObjectId
  location      String?
  remarks       String?
  timestamp     DateTime  @default(now())

  garment       Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)
}

model GarmentInventoryTransaction {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  skuId         String    @db.ObjectId
  type          String    
  qtyChange     Int
  beforeQty     Int
  afterQty      Int
  referenceId   String?   
  userId        String?   @db.ObjectId
  notes         String?
  timestamp     DateTime  @default(now())

  sku           SKU       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// --------------------------------------------------
// FABRICATOR & CHALLANS
// --------------------------------------------------
model Challan {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  challanNumber   String    @unique
  fabricatorId    String    @db.ObjectId
  cuttingBatchId  String    @db.ObjectId
  expectedQty     Int
  receivedQty     Int       @default(0)
  status          String    @default("DRAFT") 
  issuedById      String?   @db.ObjectId
  notes           String?
  date            DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fabricator      Fabricator @relation(fields: [fabricatorId], references: [id], onDelete: Restrict)
  cuttingBatch    CuttingBatch @relation(fields: [cuttingBatchId], references: [id], onDelete: Restrict)
  items           ChallanItem[]
}

model ChallanItem {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  challanId     String    @db.ObjectId
  garmentId     String    @db.ObjectId
  status        String    @default("ISSUED") 
  receivedAt    DateTime?

  challan       Challan   @relation(fields: [challanId], references: [id], onDelete: Cascade)
  garment       Garment   @relation(fields: [garmentId], references: [id], onDelete: Restrict)
  @@unique([challanId, garmentId])
}

// --------------------------------------------------
// SHOPIFY INTEGRATION
// --------------------------------------------------
model ShopifyWebhookEvent {
  id            String    @id @map("_id") // Strings allowed as IDs if using map("_id")
  eventType     String
  processedAt   DateTime  @default(now())
  status        String    @default("PROCESSED") 
  payload       String?
}

// --------------------------------------------------
// SYSTEM AUDIT & SETTINGS
// --------------------------------------------------
model AuditLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  eventType     String
  entityType    String
  entityId      String
  userId        String?  @db.ObjectId
  previousState String?
  newState      String?
  metadata      String?
  timestamp     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}
